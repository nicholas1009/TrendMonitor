# Official unified credential name used by HiThink Financial-API.
HITHINK_FINANCE_API_KEY=

# Longbridge legacy API-key authentication for the official Python SDK.
# OAuth 2.0 is recommended by Longbridge for new interactive integrations,
# but this local non-interactive Provider reads only these environment values.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Optional industry-data feasibility probe. No Tushare integration is enabled
# unless a user supplies one of these values locally.
TUSHARE_TOKEN=
TUSHARE_API_TOKEN=

# Optional Bark iPhone notifications. Keep the device key local and secret.
BARK_ENABLED=false
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=
